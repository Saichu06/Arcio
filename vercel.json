{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/exp/(.*)",
      "destination": "/exp/$1.html"
    },
    {
      "source": "/advance/(.*)",
      "destination": "/advance/$1.html"
    }
  ]
}
